<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.itau.case</groupId>
    <artifactId>purchase-approval-agent</artifactId>
    <version>0.1.0</version>
    <name>purchase-approval-agent</name>
    <description>Agente LLM de aprovação de solicitações de compra (case Itaú - LLM Engineering)</description>

    <properties>
        <java.version>21</java.version>
        <anthropic.version>2.68.0</anthropic.version>
        <json-schema-validator.version>1.5.9</json-schema-validator.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <!-- Tags JUnit excluídas do build padrão: evals rodam em profiles próprios -->
        <test.excludedGroups>eval</test.excludedGroups>
        <test.groups></test.groups>
        <llm.provider>fake</llm.provider>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- LLM: SDK oficial Anthropic -->
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>${anthropic.version}</version>
        </dependency>

        <!-- Contratos: JSON Schema 2020-12 -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${json-schema-validator.version}</version>
        </dependency>

        <!-- Resiliência (core, sem auto-config, para controle explícito) -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-retry</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <groups>${test.groups}</groups>
                    <excludedGroups>${test.excludedGroups}</excludedGroups>
                    <systemPropertyVariables>
                        <llm.provider>${llm.provider}</llm.provider>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Golden set contra o LLM fake: testa pipeline, guardrails e fallbacks (CI) -->
        <profile>
            <id>eval-fake</id>
            <properties>
                <test.groups>eval</test.groups>
                <test.excludedGroups></test.excludedGroups>
                <llm.provider>fake</llm.provider>
            </properties>
        </profile>
        <!-- Golden set contra o Claude real: mede qualidade do modelo/prompt (manual, custa $) -->
        <profile>
            <id>eval</id>
            <properties>
                <test.groups>eval</test.groups>
                <test.excludedGroups></test.excludedGroups>
                <llm.provider>anthropic</llm.provider>
            </properties>
        </profile>
    </profiles>
</project>
